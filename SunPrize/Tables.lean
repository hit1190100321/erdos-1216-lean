def matchesBits (g : Nat → Nat → Bool) (code : Nat) : Prop :=
  (if code.testBit 0 then g 0 1 = true else ¬ g 0 1 = true) ∧ (if code.testBit 1 then g 0 2 = true else ¬ g 0 2 = true) ∧ (if code.testBit 2 then g 0 3 = true else ¬ g 0 3 = true) ∧ (if code.testBit 3 then g 0 4 = true else ¬ g 0 4 = true) ∧ (if code.testBit 4 then g 0 5 = true else ¬ g 0 5 = true) ∧ (if code.testBit 5 then g 0 6 = true else ¬ g 0 6 = true) ∧ (if code.testBit 6 then g 1 2 = true else ¬ g 1 2 = true) ∧ (if code.testBit 7 then g 1 3 = true else ¬ g 1 3 = true) ∧ (if code.testBit 8 then g 1 4 = true else ¬ g 1 4 = true) ∧ (if code.testBit 9 then g 1 5 = true else ¬ g 1 5 = true) ∧ (if code.testBit 10 then g 1 6 = true else ¬ g 1 6 = true) ∧ (if code.testBit 11 then g 2 3 = true else ¬ g 2 3 = true) ∧ (if code.testBit 12 then g 2 4 = true else ¬ g 2 4 = true) ∧ (if code.testBit 13 then g 2 5 = true else ¬ g 2 5 = true) ∧ (if code.testBit 14 then g 2 6 = true else ¬ g 2 6 = true) ∧ (if code.testBit 15 then g 3 4 = true else ¬ g 3 4 = true) ∧ (if code.testBit 16 then g 3 5 = true else ¬ g 3 5 = true) ∧ (if code.testBit 17 then g 3 6 = true else ¬ g 3 6 = true) ∧ (if code.testBit 18 then g 4 5 = true else ¬ g 4 5 = true) ∧ (if code.testBit 19 then g 4 6 = true else ¬ g 4 6 = true) ∧ (if code.testBit 20 then g 5 6 = true else ¬ g 5 6 = true) ∧ True

def paley (a b : Fin 7) : Bool := decide (((b.val + 7 - a.val) % 7) ∈ ([1, 2, 4] : List Nat))

theorem canonicalRows_injective : ∀ index : Fin 240, Function.Injective (canonicalRows index) := by
  unfold Function.Injective canonicalRows
  decide

theorem canonicalCodes_correct : ∀ index : Fin 240,
  (canonicalCodes index).testBit 0 = paley (canonicalRows index 0) (canonicalRows index 1) ∧ (canonicalCodes index).testBit 1 = paley (canonicalRows index 0) (canonicalRows index 2) ∧ (canonicalCodes index).testBit 2 = paley (canonicalRows index 0) (canonicalRows index 3) ∧ (canonicalCodes index).testBit 3 = paley (canonicalRows index 0) (canonicalRows index 4) ∧ (canonicalCodes index).testBit 4 = paley (canonicalRows index 0) (canonicalRows index 5) ∧ (canonicalCodes index).testBit 5 = paley (canonicalRows index 0) (canonicalRows index 6) ∧ (canonicalCodes index).testBit 6 = paley (canonicalRows index 1) (canonicalRows index 2) ∧ (canonicalCodes index).testBit 7 = paley (canonicalRows index 1) (canonicalRows index 3) ∧ (canonicalCodes index).testBit 8 = paley (canonicalRows index 1) (canonicalRows index 4) ∧ (canonicalCodes index).testBit 9 = paley (canonicalRows index 1) (canonicalRows index 5) ∧ (canonicalCodes index).testBit 10 = paley (canonicalRows index 1) (canonicalRows index 6) ∧ (canonicalCodes index).testBit 11 = paley (canonicalRows index 2) (canonicalRows index 3) ∧ (canonicalCodes index).testBit 12 = paley (canonicalRows index 2) (canonicalRows index 4) ∧ (canonicalCodes index).testBit 13 = paley (canonicalRows index 2) (canonicalRows index 5) ∧ (canonicalCodes index).testBit 14 = paley (canonicalRows index 2) (canonicalRows index 6) ∧ (canonicalCodes index).testBit 15 = paley (canonicalRows index 3) (canonicalRows index 4) ∧ (canonicalCodes index).testBit 16 = paley (canonicalRows index 3) (canonicalRows index 5) ∧ (canonicalCodes index).testBit 17 = paley (canonicalRows index 3) (canonicalRows index 6) ∧ (canonicalCodes index).testBit 18 = paley (canonicalRows index 4) (canonicalRows index 5) ∧ (canonicalCodes index).testBit 19 = paley (canonicalRows index 4) (canonicalRows index 6) ∧ (canonicalCodes index).testBit 20 = paley (canonicalRows index 5) (canonicalRows index 6) ∧ True := by
  unfold canonicalCodes canonicalRows paley
  decide

end SunPrize
